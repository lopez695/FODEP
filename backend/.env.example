# Copier ce fichier vers backend/.env puis renseigner les valeurs locales.
# Aucun secret reel ne doit figurer ici : ce fichier est versionne.

# --- Authentification (deploiement web) -------------------------------------
# 1 = jeton obligatoire sur toutes les routes.
# 0 = aucune authentification (poste de travail, backend lie a 127.0.0.1).
RWA_AUTH_ENABLED=0

# Secret de signature des jetons. OBLIGATOIRE des que RWA_AUTH_ENABLED=1.
# 32 caracteres minimum ; l'API refuse de demarrer en dessous.
# En generer un avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Le changer invalide toutes les sessions ouvertes.
RWA_JWT_SECRET=

# Duree du jeton d'acces, garde en memoire vive du navigateur.
RWA_ACCESS_TOKEN_MINUTES=60
# Duree du cookie de renouvellement (une journee de travail).
RWA_REFRESH_TOKEN_HOURS=12
# 1 en production : le cookie n'est alors transmis qu'en HTTPS.
RWA_REFRESH_COOKIE_SECURE=1

# --- Appels navigateur ------------------------------------------------------
# Origines autorisees, separees par des virgules, sans joker.
# Inutile si l'API et l'application sont servies par le meme domaine.
# Exemple : https://risk.mabanque.ci
RWA_ALLOWED_ORIGINS=

# --- Moteur IA courbe des taux (optionnel) ----------------------------------
GEMINI_API_KEY=
YIELD_CURVE_AI_MODEL=gemini-2.5-flash-lite

# Optionnel, uniquement pour brancher un autre moteur IA compatible.
# YIELD_CURVE_AI_ENDPOINT=
