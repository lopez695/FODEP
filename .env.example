# Configuration du deploiement web. Copier en « .env » a la racine.
# Le fichier .env n'est jamais versionne : il porte les secrets.

# --- Secret de signature des jetons (OBLIGATOIRE) ---------------------------
# En generer un avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 32 caracteres minimum. Le changer deconnecte tout le monde.
RWA_JWT_SECRET=

# --- Duree des sessions -----------------------------------------------------
RWA_ACCESS_TOKEN_MINUTES=60
RWA_REFRESH_TOKEN_HOURS=12

# --- Domaine et HTTPS -------------------------------------------------------
# Serveur public avec DNS : mettre le domaine reel et l'adresse de contact,
# puis choisir Caddyfile.public. Caddy obtient seul le certificat.
# Reseau interne : laisser localhost (ou le nom interne) et Caddyfile.interne.
RWA_DOMAINE=localhost
RWA_EMAIL=

# Configuration du proxy :
#   ./deploy/Caddyfile.public   -> serveur public, certificat Let's Encrypt
#   ./deploy/Caddyfile.interne  -> reseau interne, certificat DSI ou local
RWA_CADDYFILE=./deploy/Caddyfile.interne

# --- Origines autorisees ----------------------------------------------------
# A laisser vide dans le montage standard : l'application et l'API partagent
# le meme domaine, il n'y a donc aucune requete d'origine croisee.
# A remplir uniquement si le frontend est servi ailleurs, sans joker.
RWA_ALLOWED_ORIGINS=
